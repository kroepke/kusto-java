<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.graylog.kusto</groupId>
    <artifactId>kusto-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>kusto-language-conformance</artifactId>
  <packaging>jar</packaging>
  <name>Kusto Language Conformance</name>
  <description>Conformance tests comparing the port against .NET oracle goldens (tests only).</description>

  <properties>
    <!-- Passed through to the tests; empty means unset (see Harness). -->
    <kusto.goldens></kusto.goldens>
    <kusto.port></kusto.port>
    <kusto.requireGoldens>false</kusto.requireGoldens>
    <kusto.fuzzSeed></kusto.fuzzSeed>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.graylog.kusto</groupId>
      <artifactId>kusto-language</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>-Xss16m</argLine>
          <trimStackTrace>false</trimStackTrace>
          <systemPropertyVariables>
            <kusto.basedir>${project.basedir}</kusto.basedir>
            <kusto.goldens>${kusto.goldens}</kusto.goldens>
            <kusto.port>${kusto.port}</kusto.port>
            <kusto.requireGoldens>${kusto.requireGoldens}</kusto.requireGoldens>
            <kusto.fuzzSeed>${kusto.fuzzSeed}</kusto.fuzzSeed>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
